# Weather Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ============================================================
# LLM Configuration
# ============================================================

# LLM provider: "groq" (default) or "ollama"
LLM_PROVIDER=groq

# Groq API key (required when LLM_PROVIDER=groq)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model name
GROQ_MODEL=qwen/qwen3.8-27b

# Ollama settings (required when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ============================================================
# Satellite (optional)
# ============================================================

# Planetary Computer API key (optional — satellite data via pystac-client)
# Get yours at: https://planetarycomputer.microsoft.com/
# PLANETARY_COMPUTER_API_KEY=your_key_here

# ============================================================
# Application
# ============================================================

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# HuggingFace offline mode (set to 1 in Docker/offline environments)
# TRANSFORMERS_OFFLINE=1
# HF_DATASETS_OFFLINE=1
